{
  "expo": {
    "name": "XamReader",
    "slug": "xam-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.xamreader",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép truy cập Thư viện ảnh.",
          "savePhotosPermission": "Cho phép lưu ảnh đã tải vào Thư viện ảnh."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "338d6b39-9575-4ef0-b91e-27063608bf7f"
      }
    }
  }
}
